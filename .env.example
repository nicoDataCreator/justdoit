# ==============================================================================
# VARIABLES SECRETAS DE SERVIDOR (VERCEL & LOCAL)
# Configúralas en Vercel > Project Settings > Environment Variables
# NUNCA se exponen en el frontend ni en el bundle compilado
# ==============================================================================

# Clave secreta personal para autenticar el sistema (por defecto: sp_live_mudo6z9m4qf12n)
API_SECRET_KEY=sp_live_mudo6z9m4qf12n

# Token de tu Bot de Telegram entregado por @BotFather (ej. 7123456789:AAFlm3xYZ...)
TELEGRAM_BOT_TOKEN=

# Tu Chat ID personal de Telegram (ej. 123456789)
TELEGRAM_CHAT_ID=

# URL pública de tu aplicación en Vercel (opcional, ej. https://mi-semana-madrid.vercel.app)
APP_URL=

# Gemini API Key (opcional, si se usan funciones de IA server-side)
GEMINI_API_KEY=
